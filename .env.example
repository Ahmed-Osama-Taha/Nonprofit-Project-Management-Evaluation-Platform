# ─────────────────────────────────────────────────────────────
# Nonprofit Project Management & Evaluation Platform — env sample
# Copy to `.env` and adjust. `docker compose` reads this file.
# ─────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────
# Change this in any real deployment. Used to sign JWTs.
SECRET_KEY=dev-super-secret-change-me
ENVIRONMENT=development
ACCESS_TOKEN_EXPIRE_MINUTES=720

# ── Database (PostgreSQL + pgvector) ─────────────────────────
POSTGRES_USER=nppm
POSTGRES_PASSWORD=nppm
POSTGRES_DB=nppm
# Hostname `db` is the compose service name.
DATABASE_URL=postgresql+psycopg://nppm:nppm@db:5432/nppm

# ── Object storage (MinIO / S3-compatible) ───────────────────
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=nppm-documents
S3_REGION=us-east-1

# ── AI (OpenAI-compatible) ───────────────────────────────────
# REQUIRED for AI features. Works with OpenAI or any compatible
# gateway (Azure OpenAI, OpenRouter, local vLLM/Ollama, etc.).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AI_CHAT_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_DIM=1536

# ── Seed data (demo accounts created on first boot) ──────────
SEED_ON_STARTUP=true
SEED_ADMIN_EMAIL=admin@demo.org
SEED_ADMIN_PASSWORD=Admin123!
SEED_REVIEWER_EMAIL=reviewer@demo.org
SEED_REVIEWER_PASSWORD=Reviewer123!
SEED_ORG_EMAIL=org@demo.org
SEED_ORG_PASSWORD=Org123!

# ── Frontend ─────────────────────────────────────────────────
# Base URL the browser uses to reach the API.
NEXT_PUBLIC_API_URL=http://localhost:8000
