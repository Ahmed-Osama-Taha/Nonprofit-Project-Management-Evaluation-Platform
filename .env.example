# ─────────────────────────────────────────────────────────────
# Athar (أثر) — Nonprofit Project Management & Evaluation Platform
# Copy to `.env` and adjust. `docker compose` reads this file.
# ─────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────
# Change this in any real deployment. Used to sign JWTs.
SECRET_KEY=dev-super-secret-change-me
ENVIRONMENT=development
ACCESS_TOKEN_EXPIRE_MINUTES=720
DEFAULT_CURRENCY=SAR

# ── Database (PostgreSQL + pgvector) ─────────────────────────
POSTGRES_USER=nppm
POSTGRES_PASSWORD=nppm
POSTGRES_DB=nppm
# Hostname `db` is the compose service name.
DATABASE_URL=postgresql+psycopg://nppm:nppm@db:5432/nppm

# ── Object storage (MinIO / S3-compatible) ───────────────────
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=nppm-documents
S3_REGION=us-east-1
# Ship every audit entry to object storage (durable, append-only journal).
AUDIT_TO_S3=true

# ── AI — LLM provider ────────────────────────────────────────
# The platform runs fully WITHOUT a key; AI features are additive.
# Provider: "anthropic" (Claude, default) or "openai".
AI_PROVIDER=anthropic

# Anthropic Claude — set your key to enable AI analysis & the RAG assistant.
ANTHROPIC_API_KEY=
# Model id — configurable. Examples: claude-opus-5, claude-sonnet-5, claude-haiku-4-5.
ANTHROPIC_MODEL=claude-opus-5
# ANTHROPIC_BASE_URL=            # optional: for a gateway/proxy

# ── AI — embeddings (pluggable, independent of the LLM) ──────
# "local"  → deterministic hashing embedding; NO external key needed, so RAG
#            works with only a Claude key. "openai" → hosted embeddings model.
EMBEDDING_PROVIDER=local
AI_EMBEDDING_DIM=1536

# OpenAI-compatible provider (only if AI_PROVIDER=openai or EMBEDDING_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AI_CHAT_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small

# ── Seed data (demo accounts created on first boot) ──────────
SEED_ON_STARTUP=true
SEED_ADMIN_EMAIL=admin@demo.org
SEED_ADMIN_PASSWORD=Admin123!
SEED_REVIEWER_EMAIL=reviewer@demo.org
SEED_REVIEWER_PASSWORD=Reviewer123!
SEED_ORG_EMAIL=org@demo.org
SEED_ORG_PASSWORD=Org123!

# ── Frontend ─────────────────────────────────────────────────
# Leave EMPTY (recommended): the browser calls the same origin (/api/*) and the
# Next server proxies to the backend — so a single ngrok/Cloudflare tunnel to
# port 3000 works with no CORS or mixed-content issues.
#   ngrok:  ngrok http 3000   → open the https URL, sign in — done.
# Only set this if you deliberately want the browser to call the API directly.
NEXT_PUBLIC_API_URL=
# Where the Next server proxies /api/* to (compose service name inside Docker).
API_PROXY_TARGET=http://backend:8000
